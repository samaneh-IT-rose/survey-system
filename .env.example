# ── نمونه تنظیمات محیطی — این فایل را به .env کپی و مقدارها را تغییر دهید ──
# در استقرار با systemd، این مقادیر داخل EnvironmentFile فایل سرویس خوانده می‌شود.

# نشانی دیتابیس PostgreSQL (الزامی در سرور)
SURVEY_DATABASE_URL=postgresql+psycopg2://survey:CHANGE_ME@127.0.0.1:5432/surveydb

# نام سازمان در سربرگ‌ها (وب، چاپ و PDF)
SURVEY_ORG_NAME=راه زندگی

# نشانی لوگو (فایل داخل app/static/logo/ قرار دارد)
SURVEY_LOGO_URL=/app/static/logo/logo.png

# نشانی خود سرویس برای رندر PDF (پورت باید با پورت uvicorn یکسان باشد)
SURVEY_SELF_URL=http://127.0.0.1:8000
