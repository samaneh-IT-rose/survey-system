# ── نمونه پیکربندی nginx (پروکسی به uvicorn) ──
# نصب خودکار توسط deploy/install.sh انجام می‌شود.
# برای نصب دستی: در /etc/nginx/sites-available/survey-system قرار دهید و
# با  ln -sf /etc/nginx/sites-available/survey-system /etc/nginx/sites-enabled/  فعال کنید.

server {
    listen 8090;                # پورت فرانت — همان که در مرورگر باز می‌شود
    server_name _;              # نام دامنه خود را بگذارید، مثلاً survey.example.com
    client_max_body_size 10m;

    # فایل‌های استاتیک مستقیماً توسط nginx سرو می‌شوند (سریع‌تر)
    location /app/static/ {
        alias /opt/survey-system/app/static/;
        expires 30d;
        access_log off;
    }

    # بقیه درخواست‌ها به uvicorn
    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;   # تولید PDF ممکن است کمی طول بکشد
    }
}
